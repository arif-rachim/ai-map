# Data pipeline configuration. Run on the ONLINE build machine.
# Override any value via environment variable, e.g. REGION_MAXZOOM=13 ./build.sh tiles

# Countries with full detail (ISO 3166-1 alpha-2).
# GCC | North Africa (incl. Western Sahara) | Neighbours | Levant | Sudan
REGION_COUNTRIES="${REGION_COUNTRIES:-SA,AE,QA,KW,BH,OM,EG,LY,TN,DZ,MA,EH,YE,IQ,JO,IR,TR,SY,LB,IL,PS,SD}"
# Buffer around country borders/coastlines so border areas and nearshore waters are detailed (km).
REGION_BUFFER_KM="${REGION_BUFFER_KM:-25}"

# Protomaps daily planet build: "latest" or a date like 20260917.
PROTOMAPS_BUILD="${PROTOMAPS_BUILD:-latest}"
REGION_MAXZOOM="${REGION_MAXZOOM:-15}"
WORLD_MAXZOOM="${WORLD_MAXZOOM:-7}"
# Optional bbox (minLon,minLat,maxLon,maxLat) instead of the country polygon - for quick dev extracts.
REGION_BBOX="${REGION_BBOX:-}"

# Photon geocoder (prebuilt GraphHopper JSON dumps, merged and imported locally).
PHOTON_VERSION="${PHOTON_VERSION:-1.3.0}"
PHOTON_DUMP_FORMAT="${PHOTON_DUMP_FORMAT:-1.0}"
PHOTON_LANGUAGES="${PHOTON_LANGUAGES:-en}"
PHOTON_DUMPS="${PHOTON_DUMPS:-asia/arabian-peninsula asia/iran asia/iraq asia/jordan asia/isreal asia/lebanon asia/palestine asia/syria africa/northern-africa europe/turkey}"
PHOTON_JAVA_IMAGE="${PHOTON_JAVA_IMAGE:-eclipse-temurin:21-jre}"

PMTILES_VERSION="${PMTILES_VERSION:-1.31.2}"
BASEMAPS_ASSETS_REF="${BASEMAPS_ASSETS_REF:-main}"

# Transfer medium limit per bundle (GB).
BUNDLE_MAX_GB="${BUNDLE_MAX_GB:-50}"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_DIR="${OUT_DIR:-$ROOT_DIR/dist-data}"
WORK_DIR="${WORK_DIR:-$ROOT_DIR/work}"

# Terrain (phase 2): Mapterhorn Terrarium-encoded DEM (webp, 512px), clipped to the region polygon.
TERRAIN_SOURCE="${TERRAIN_SOURCE:-https://download.mapterhorn.com/planet.pmtiles}"
TERRAIN_MAXZOOM="${TERRAIN_MAXZOOM:-12}"
