# Copy to .env next to docker-compose.yml and adjust.
DATA_ROOT=/opt/aimap/data
HTTP_PORT=80
POSTGRES_PASSWORD=change-me
PHOTON_HEAP=4g
# UID/GID owning DATA_ROOT/photon (Photon writes runtime files into its data dir).
AIMAP_UID=1000
AIMAP_GID=1000
AIMAP_VERSION=latest
# Public base URL used in API links (TileJSON, styles, OGC). TLS is terminated by the load balancer,
# which forwards plain HTTP to HTTP_PORT; both http:// and https:// keep working for clients.
# Leave empty to derive links from each request instead.
PUBLIC_URL=https://map.jac.mil.ae
# Admin access (everyone else is read-only). install.sh generates these on first install.
# ADMIN_PASSWORD: login in the web app (lock button). ADMIN_API_TOKEN: Bearer token for other applications.
# AUTH_SECRET: signs admin sessions. Changing ADMIN_PASSWORD or AUTH_SECRET signs every admin out.
ADMIN_PASSWORD=change-me
ADMIN_API_TOKEN=change-me-too
AUTH_SECRET=change-me-as-well
