# Copy to .env next to docker-compose.yml and adjust.
DATA_ROOT=/opt/aimap/data
HTTP_PORT=80
POSTGRES_PASSWORD=change-me
PHOTON_HEAP=4g
# UID/GID owning DATA_ROOT/photon (Photon writes runtime files into its data dir).
AIMAP_UID=1000
AIMAP_GID=1000
AIMAP_VERSION=latest
# Public base URL used in API links (TileJSON, styles, OGC). TLS is terminated by the load balancer,
# which forwards plain HTTP to HTTP_PORT; both http:// and https:// keep working for clients.
# Leave empty to derive links from each request instead.
PUBLIC_URL=https://map.jac.mil.ae
